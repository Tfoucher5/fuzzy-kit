{
  "name": "fuzzy-toolkit",
  "version": "2.2.0",
  "description": "Fuzzy string matching toolkit and drop-in replacement for string-similarity (compareTwoStrings, findBestMatch), 3x faster. Typo-tolerant similarity, search-as-you-type, did-you-mean, highlight, dedupe, join, Levenshtein, Dice, Jaro-Winkler. Zero dependencies, TypeScript, ESM + CommonJS.",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-tools",
    "fuzzy",
    "fuzzy-matching",
    "fuzzy-search",
    "string-similarity",
    "levenshtein",
    "damerau-levenshtein",
    "jaro-winkler",
    "typo",
    "autocomplete",
    "search",
    "quiz",
    "blind-test",
    "answer-checking",
    "dedupe",
    "normalize",
    "typescript",
    "highlight",
    "fuzzy-find",
    "spell-check",
    "did-you-mean",
    "dice-coefficient",
    "jaccard",
    "cosine-similarity",
    "fuse",
    "string-similarity-alternative",
    "compareTwoStrings",
    "findBestMatch",
    "sorensen-dice",
    "similarity",
    "string-distance",
    "edit-distance",
    "hamming",
    "lcs",
    "fuzzy-string",
    "text-similarity",
    "deduplication",
    "record-linkage",
    "fuse.js-alternative"
  ],
  "license": "MIT",
  "author": "Theo Foucher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tfoucher5/fuzzy-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Tfoucher5/fuzzy-toolkit/issues"
  },
  "homepage": "https://tfoucher5.github.io/fuzzy-toolkit/",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "fuzzy-toolkit": "./bin/fuzzy-toolkit.mjs",
    "guess-rater": "./bin/fuzzy-toolkit.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./string-similarity": {
      "import": {
        "types": "./dist/esm/compat/string-similarity.d.ts",
        "default": "./dist/esm/compat/string-similarity.js"
      },
      "require": {
        "types": "./dist/cjs/compat/string-similarity.d.ts",
        "default": "./dist/cjs/compat/string-similarity.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./lang/en": {
      "import": {
        "types": "./dist/esm/lang/en.d.ts",
        "default": "./dist/esm/lang/en.js"
      },
      "require": {
        "types": "./dist/cjs/lang/en.d.ts",
        "default": "./dist/cjs/lang/en.js"
      }
    },
    "./lang/fr": {
      "import": {
        "types": "./dist/esm/lang/fr.d.ts",
        "default": "./dist/esm/lang/fr.js"
      },
      "require": {
        "types": "./dist/cjs/lang/fr.d.ts",
        "default": "./dist/cjs/lang/fr.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.cjs",
    "golden:update": "npm run build && node scripts/golden.mjs --update",
    "bench": "npm run build && node bench/bench.mjs",
    "prepublishOnly": "npm test",
    "docs:dev": "node scripts/llms-full.mjs && vitepress dev docs",
    "docs:build": "node scripts/llms-full.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench:real": "npm run build && node bench/real-data.mjs",
    "bench:check": "npm run build && node bench/real-data.mjs --check",
    "bench:baseline": "npm run build && node bench/real-data.mjs --update-baseline",
    "bench:versus": "npm run build && node bench/versus.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "size:check": "npm run build && node scripts/size.mjs --check"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "fastest-levenshtein": "^1.0.16",
    "fuse.js": "^7.5.0",
    "fuzzysort": "^4.0.2",
    "match-sorter": "^6.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "string-similarity": "^4.0.4",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "unpkg": "./dist/browser/fuzzy-toolkit.iife.min.js",
  "jsdelivr": "./dist/browser/fuzzy-toolkit.iife.min.js",
  "overrides": {
    "esbuild": "$esbuild",
    "vite": "^6.4.4"
  }
}
