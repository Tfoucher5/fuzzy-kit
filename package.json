{
  "name": "fuzzy-toolkit",
  "version": "2.9.0",
  "description": "Fuzzy string matching and fuzzy search for JavaScript and TypeScript: typo-tolerant similarity, search as you type (13x faster than Fuse.js, finds more), did you mean, find names in text, dedupe, standardize and join, map CSV columns, repair LLM JSON output. Drop-in for Fuse.js and string-similarity, React/Vue/Svelte helpers, Web Worker, CLI, MCP server. Zero dependencies, TypeScript, ESM + CommonJS.",
  "mcpName": "io.github.Tfoucher5/fuzzy-toolkit",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-tools",
    "fuzzy",
    "fuzzy-matching",
    "fuzzy-search",
    "string-similarity",
    "levenshtein",
    "damerau-levenshtein",
    "jaro-winkler",
    "typo",
    "autocomplete",
    "search",
    "quiz",
    "blind-test",
    "answer-checking",
    "dedupe",
    "normalize",
    "typescript",
    "highlight",
    "fuzzy-find",
    "spell-check",
    "did-you-mean",
    "dice-coefficient",
    "jaccard",
    "cosine-similarity",
    "fuse",
    "string-similarity-alternative",
    "compareTwoStrings",
    "findBestMatch",
    "sorensen-dice",
    "similarity",
    "string-distance",
    "edit-distance",
    "hamming",
    "lcs",
    "fuzzy-string",
    "text-similarity",
    "deduplication",
    "record-linkage",
    "fuse.js-alternative",
    "fusejs",
    "fuzzy-join",
    "data-cleaning",
    "csv",
    "column-mapping",
    "schema-mapping",
    "json-repair",
    "llm",
    "llm-output",
    "structured-output",
    "vue",
    "svelte",
    "vue-composable",
    "svelte-store",
    "web-worker",
    "worker"
  ],
  "license": "MIT",
  "author": "Theo Foucher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tfoucher5/fuzzy-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Tfoucher5/fuzzy-toolkit/issues"
  },
  "funding": "https://ko-fi.com/theofoucher",
  "homepage": "https://tfoucher5.github.io/fuzzy-toolkit/",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "string-similarity": ["dist/esm/compat/string-similarity.d.ts"],
      "fuse": ["dist/cjs/compat/fuse.d.ts"],
      "react": ["dist/esm/react.d.ts"],
      "vue": ["dist/esm/vue.d.ts"],
      "svelte": ["dist/esm/svelte.d.ts"],
      "worker": ["dist/esm/worker.d.ts"],
      "worker/serve": ["dist/esm/worker-serve.d.ts"],
      "lang/en": ["dist/esm/lang/en.d.ts"],
      "lang/fr": ["dist/esm/lang/fr.d.ts"],
      "lang/es": ["dist/esm/lang/es.d.ts"],
      "lang/de": ["dist/esm/lang/de.d.ts"],
      "lang/it": ["dist/esm/lang/it.d.ts"],
      "lang/nl": ["dist/esm/lang/nl.d.ts"],
      "testing": ["dist/esm/testing.d.ts"]
    }
  },
  "bin": {
    "fuzzy-toolkit": "./bin/fuzzy-toolkit.mjs",
    "guess-rater": "./bin/fuzzy-toolkit.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./string-similarity": {
      "import": {
        "types": "./dist/esm/compat/string-similarity.d.ts",
        "default": "./dist/esm/compat/string-similarity.js"
      },
      "require": {
        "types": "./dist/cjs/compat/string-similarity.d.ts",
        "default": "./dist/cjs/compat/string-similarity.js"
      }
    },
    "./fuse": {
      "import": {
        "types": "./dist/esm/compat/fuse.d.ts",
        "default": "./dist/esm/compat/fuse.js"
      },
      "require": {
        "types": "./dist/cjs/compat/fuse.d.ts",
        "default": "./dist/cjs/compat/fuse.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/esm/vue.d.ts",
        "default": "./dist/esm/vue.js"
      },
      "require": {
        "types": "./dist/cjs/vue.d.ts",
        "default": "./dist/cjs/vue.js"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/esm/svelte.d.ts",
        "default": "./dist/esm/svelte.js"
      },
      "require": {
        "types": "./dist/cjs/svelte.d.ts",
        "default": "./dist/cjs/svelte.js"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/esm/worker.d.ts",
        "default": "./dist/esm/worker.js"
      },
      "require": {
        "types": "./dist/cjs/worker.d.ts",
        "default": "./dist/cjs/worker.js"
      }
    },
    "./worker/serve": {
      "import": {
        "types": "./dist/esm/worker-serve.d.ts",
        "default": "./dist/esm/worker-serve.js"
      },
      "require": {
        "types": "./dist/cjs/worker-serve.d.ts",
        "default": "./dist/cjs/worker-serve.js"
      }
    },
    "./lang/en": {
      "import": {
        "types": "./dist/esm/lang/en.d.ts",
        "default": "./dist/esm/lang/en.js"
      },
      "require": {
        "types": "./dist/cjs/lang/en.d.ts",
        "default": "./dist/cjs/lang/en.js"
      }
    },
    "./lang/fr": {
      "import": {
        "types": "./dist/esm/lang/fr.d.ts",
        "default": "./dist/esm/lang/fr.js"
      },
      "require": {
        "types": "./dist/cjs/lang/fr.d.ts",
        "default": "./dist/cjs/lang/fr.js"
      }
    },
    "./lang/es": {
      "import": {
        "types": "./dist/esm/lang/es.d.ts",
        "default": "./dist/esm/lang/es.js"
      },
      "require": {
        "types": "./dist/cjs/lang/es.d.ts",
        "default": "./dist/cjs/lang/es.js"
      }
    },
    "./lang/de": {
      "import": {
        "types": "./dist/esm/lang/de.d.ts",
        "default": "./dist/esm/lang/de.js"
      },
      "require": {
        "types": "./dist/cjs/lang/de.d.ts",
        "default": "./dist/cjs/lang/de.js"
      }
    },
    "./lang/it": {
      "import": {
        "types": "./dist/esm/lang/it.d.ts",
        "default": "./dist/esm/lang/it.js"
      },
      "require": {
        "types": "./dist/cjs/lang/it.d.ts",
        "default": "./dist/cjs/lang/it.js"
      }
    },
    "./lang/nl": {
      "import": {
        "types": "./dist/esm/lang/nl.d.ts",
        "default": "./dist/esm/lang/nl.js"
      },
      "require": {
        "types": "./dist/cjs/lang/nl.d.ts",
        "default": "./dist/cjs/lang/nl.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.js tests/*.test.cjs",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/esm/** --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 tests/*.test.mjs tests/*.test.js tests/*.test.cjs",
    "golden:update": "npm run build && node scripts/golden.mjs --update",
    "bench": "npm run build && node bench/bench.mjs",
    "prepublishOnly": "npm test",
    "docs:dev": "node scripts/llms-full.mjs && vitepress dev docs",
    "docs:build": "node scripts/llms-full.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench:real": "npm run build && node bench/real-data.mjs",
    "bench:check": "npm run build && node bench/real-data.mjs --check",
    "bench:baseline": "npm run build && node bench/real-data.mjs --update-baseline",
    "bench:versus": "npm run build && node bench/versus.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "size:check": "npm run build && node scripts/size.mjs --check",
    "languages:coverage": "npm run build && node scripts/language-coverage.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "fast-check": "^4.11.0",
    "fastest-levenshtein": "^1.0.16",
    "fuse.js": "^7.5.0",
    "fuzzysort": "^4.0.2",
    "match-sorter": "^6.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "string-similarity": "^4.0.4",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "unpkg": "./dist/browser/fuzzy-toolkit.iife.min.js",
  "jsdelivr": "./dist/browser/fuzzy-toolkit.iife.min.js",
  "overrides": {
    "esbuild": "$esbuild",
    "vite": "^6.4.4"
  }
}
